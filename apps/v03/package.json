{
  "name": "itjima-v03",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:storage": "playwright test --config=playwright.storage.config.ts",
    "admin:check": "node --use-env-proxy scripts/supabase-admin.mjs",
    "admin:apply": "node --use-env-proxy scripts/supabase-admin.mjs --apply"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "@supabase/supabase-js": "2.108.2"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.20.0",
    "vite": "8.1.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "@playwright/test": "1.61.1",
    "@electric-sql/pglite": "0.3.14"
  }
}
