# Copy to .env for local dev. Set the same values in Vercel → Settings → Environment Variables.
VITE_SUPABASE_PROJECT_ID=your_project_ref
VITE_SUPABASE_URL=https://your_project_ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key

# Web Push — public key only (client). Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key

# Vercel only — serverless function api/brain-mirror.ts (never expose to client)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Supabase Edge Function secrets (Dashboard → Edge Functions → process-reminders → Secrets)
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:support@itjima.app
# CRON_SECRET=...
# SUPABASE_SERVICE_ROLE_KEY=... (auto-injected in hosted env)
